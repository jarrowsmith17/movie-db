// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// 3. Your Elite Media Models
model User {
  id            String      @id @default(cuid())
  name          String?
  username      String      @unique
  password      String      
  role          String      @default("user")
  createdAt     DateTime    @default(now())
  
  watchlist     Watchlist[]
  requests      Request[]
  notifications Notification[] 
  watchLogs     WatchLog[]
  reviews       Review[]
}

model Watchlist {
  id        String   @id @default(cuid())
  tmdbId    Int
  type      String   
  title     String
  poster    String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, tmdbId, type])
}

model Request {
  id         String   @id @default(cuid())
  title      String
  posterPath String?  // Ensure this is here
  tmdbId     Int
  type       String   // MOVIE or TV
  status     String   @default("PENDING")
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WatchLog {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  type      String   // "MOVIE" or "TV" to match your existing pattern
  title      String   // <-- Add this
  posterPath String?
  watchedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// 3. Add the Review model (For ratings and text)
model Review {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  type      String   // "MOVIE" or "TV"
  rating    Int      // Stores the 1-5 star rating
  content   String?  @db.Text // Optional: allows a rating without text, or long reviews
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Automatically updates when the review is "overwritten"

  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, tmdbId, type])
}